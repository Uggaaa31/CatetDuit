# Database
DB_USER=finance_user
DB_PASSWORD=finance_secret_pass
DB_NAME=finance_db
DATABASE_URL=postgresql://finance_user:finance_secret_pass@postgres:5432/finance_db

# WhatsApp Gateway
# Masukkan nomor WhatsApp Anda (format: 628xxxx tanpa tanda + atau spasi)
# Anda bisa memasukkan lebih dari satu nomor dipisahkan tanda koma
ALLOWED_NUMBERS=6281234567890

# Identitas pengguna (JANGAN hardcode nomor HP di source code)
# Nomor HP utama pemilik bot: target notifikasi & konsolidasi data LID
PRIMARY_USER_NUMBER=6281234567890
# Nomor bot sendiri, dipisah koma. Nomor ini tidak akan pernah jadi target kirim.
BOT_NUMBERS=
# ID @lid lama yang datanya harus dikonsolidasi ke PRIMARY_USER_NUMBER
LID_ALIASES=

# Gateway & API Internal URLs
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
FINANCE_API_URL=http://finance-api:3000
OCR_SERVICE_URL=http://ocr-service:8000

# OCR / Vision Service
# Dapatkan Gemini API Key gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Email Watcher (IMAP) - Opsional / Jika ingin notifikasi QRIS & Bank
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_CHECK_INTERVAL_SECONDS=30

# Cloudflare Tunnel (Opsional jika ingin diekspos ke publik)
CF_TUNNEL_TOKEN=
