# Database
DB_USER=finance_user
DB_PASSWORD=finance_secret_pass
DB_NAME=finance_db
DATABASE_URL=postgresql://finance_user:finance_secret_pass@postgres:5432/finance_db

# WhatsApp Gateway
# Masukkan nomor WhatsApp Anda (format: 628xxxx tanpa tanda + atau spasi)
# Anda bisa memasukkan lebih dari satu nomor dipisahkan tanda koma
# Gunakan ALLOWED_NUMBERS=* hanya kalau benar-benar ingin menerima pesan dari nomor mana pun
ALLOWED_NUMBERS=6281234567890

# Host binding port Docker (3000/3001/8000).
# 127.0.0.1 = hanya bisa diakses dari komputer ini (default, paling aman).
# 0.0.0.0   = bisa diakses dari perangkat lain di jaringan yang sama.
#BIND_HOST=0.0.0.0

# Identitas pengguna (JANGAN hardcode nomor HP di source code)
# Nomor HP utama pemilik bot: target notifikasi & konsolidasi data LID
PRIMARY_USER_NUMBER=6281234567890
# Nomor bot sendiri, dipisah koma. Nomor ini tidak akan pernah jadi target kirim.
BOT_NUMBERS=
# ID @lid lama yang datanya harus dikonsolidasi ke PRIMARY_USER_NUMBER
LID_ALIASES=

# Gateway & API Internal URLs
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
FINANCE_API_URL=http://finance-api:3000
OCR_SERVICE_URL=http://ocr-service:8000

# OCR / Vision Service
# Dapatkan Gemini API Key gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Asisten AI (Gemini)
# AI_ENABLED=false -> matikan semua panggilan AI (bot tetap jalan dengan parser regex)
AI_ENABLED=true
# Batas panggilan AI per pengguna per jam (0 = tanpa batas)
AI_RATE_LIMIT_PER_HOUR=30
# Timeout menunggu AI dari sisi finance-api (milidetik)
AI_TIMEOUT_MS=15000
# Timeout permintaan ke Gemini dari sisi ocr-service (milidetik, minimum 10000)
GEMINI_TIMEOUT_MS=12000
# Berapa giliran percakapan terakhir yang dikirim ke AI sebagai konteks
AI_HISTORY_TURNS=6
# Umur pertanyaan klarifikasi sebelum dianggap kedaluwarsa (milidetik)
AI_PENDING_TTL_MS=300000
# Jendela waktu (ms) untuk mencegah AI mencatat transaksi yang sama dua kali
AI_DUPLICATE_WINDOW_MS=180000

# Email Watcher (IMAP) - Opsional / Jika ingin notifikasi QRIS & Bank
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_CHECK_INTERVAL_SECONDS=30

# Cloudflare Tunnel (Opsional jika ingin diekspos ke publik)
CF_TUNNEL_TOKEN=
