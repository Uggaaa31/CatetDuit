datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id               String   @id @default(uuid())
  type             String   // "income" | "expense"
  source           String   // "manual" | "ocr" | "email_qris"
  amount           Float
  description      String
  category         String   @default("Lain-lain")
  merchantName     String?
  receiptImageUrl  String?
  notificationRaw  String?  @db.Text
  userNumber       String
  // Penanda batch untuk pencatatan banyak item sekaligus, dipakai fitur "batal"
  // agar pembatalan hanya menghapus transaksi dari satu pesan yang sama.
  batchId          String?
  createdAt        DateTime @default(now())

  @@index([userNumber])
  @@index([createdAt])
  @@index([batchId])
}

model Budget {
  id           String   @id @default(uuid())
  category     String
  monthlyLimit Float
  userNumber   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userNumber, category])
  @@index([userNumber])
}

model Bill {
  id          String   @id @default(uuid())
  name        String
  amount      Float
  dueDay      Int      // Tanggal jatuh tempo bulanan (1-31)
  category    String   @default("Listrik, Air & Wifi")
  userNumber  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userNumber])
}

model Debt {
  id          String    @id @default(uuid())
  type        String    // "debt" (kita berhutang) | "loan" (piutang / orang berhutang ke kita)
  personName  String
  amount      Float
  description String?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  userNumber  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userNumber])
  @@index([isPaid])
}

// Riwayat percakapan singkat supaya AI punya konteks ("yang tadi berapa?").
model ChatMessage {
  id         String   @id @default(uuid())
  userNumber String
  role       String   // "user" | "assistant"
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([userNumber, createdAt])
}

// Aturan pribadi per pengguna.
//   kind = "category" -> "kalau aku bilang ngopi masuk nongkrong" (kata kunci -> kantong)
//   kind = "text"     -> "kalau aku bilang goceng maksudnya 5000" (alias teks/nominal/merchant)
model UserRule {
  id         String   @id @default(uuid())
  userNumber String
  keyword    String
  category   String
  kind       String   @default("category")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userNumber, keyword])
  @@index([userNumber])
}

// Pertanyaan bot yang belum dijawab user (mis. "Rp 15.000 atau Rp 150.000?").
model PendingClarification {
  id          String   @id @default(uuid())
  userNumber  String   @unique
  question    String   @db.Text
  contextJson String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
