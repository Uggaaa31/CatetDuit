datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id               String   @id @default(uuid())
  type             String   // "income" | "expense"
  source           String   // "manual" | "ocr" | "email_qris"
  amount           Float
  description      String
  category         String   @default("Lain-lain")
  merchantName     String?
  receiptImageUrl  String?
  notificationRaw  String?  @db.Text
  userNumber       String
  // Penanda batch untuk pencatatan banyak item sekaligus, dipakai fitur "batal"
  // agar pembatalan hanya menghapus transaksi dari satu pesan yang sama.
  batchId          String?
  createdAt        DateTime @default(now())

  @@index([userNumber])
  @@index([createdAt])
  @@index([batchId])
}

model Budget {
  id           String   @id @default(uuid())
  category     String
  monthlyLimit Float
  userNumber   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userNumber, category])
  @@index([userNumber])
}

model Bill {
  id          String   @id @default(uuid())
  name        String
  amount      Float
  dueDay      Int      // Tanggal jatuh tempo bulanan (1-31)
  category    String   @default("Listrik, Air & Wifi")
  userNumber  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userNumber])
}

model Debt {
  id          String    @id @default(uuid())
  type        String    // "debt" (kita berhutang) | "loan" (piutang / orang berhutang ke kita)
  personName  String
  amount      Float
  description String?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  userNumber  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userNumber])
  @@index([isPaid])
}
